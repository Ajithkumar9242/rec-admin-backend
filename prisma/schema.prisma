generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum AdminStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_SETUP
}

enum AuditEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  TWO_FACTOR_ENROLLED
  TWO_FACTOR_VERIFIED
  TWO_FACTOR_DISABLED
  BACKUP_CODE_USED
  BACKUP_CODES_REGENERATED
  ACCOUNT_LOCKED
  SESSION_REVOKED
}

model Admin {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  name                String
  role                AdminRole            @default(ADMIN)
  status              AdminStatus          @default(ACTIVE)
  failedLoginAttempts Int                  @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime?
  totpSecret          String?
  totpEnabled         Boolean              @default(false)
  totpVerifiedAt      DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  passwordResetTokens PasswordResetToken[]
  backupCodes         AdminBackupCode[]
  auditLogs           AuthAuditLog[]
  billingAuditLogs    BillingAuditLog[]
  platformConfigAuditLogs PlatformConfigAuditLog[]
  companyAuditLogs    CompanyAuditLog[]
  teamMembers         TeamMember[]
  stageHistories      ApplicationStageHistory[]
  deviceTokens        AdminDeviceToken[]
  notifications       AdminNotification[]

  @@map("admins")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  adminId   String
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tokenHash])
  @@index([adminId, expiresAt])
  @@map("password_reset_tokens")
}

model AdminBackupCode {
  id        String    @id @default(uuid())
  adminId   String
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId, usedAt])
  @@map("admin_backup_codes")
}

model AuthAuditLog {
  id        String         @id @default(uuid())
  adminId   String?
  admin     Admin?         @relation(fields: [adminId], references: [id], onDelete: SetNull)
  eventType AuditEventType
  ipAddress String?
  userAgent String?
  details   Json?
  createdAt DateTime       @default(now())

  @@index([adminId, createdAt])
  @@index([eventType, createdAt])
  @@map("auth_audit_logs")
}

// ----------------------------------------------------
// Phase 3: Billing & Subscriptions Enums and Models
// ----------------------------------------------------

enum PlanBillingInterval {
  DAY
  MONTHLY
  YEARLY
  ONE_TIME
}

enum PlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  REVOKED
  PAST_DUE
  INCOMPLETE
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  OVERDUE
  VOID
  UNCOLLECTIBLE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum CompanyStatus {
  IN_REVIEW
  UNVERIFIED
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Company {
  id                    String        @id @default(uuid())
  name                  String
  legalName             String?
  taxId                 String?
  companyCode           String?       @unique
  registrationNumber    String?
  billingEmail          String?
  billingAddress        String?
  country               String        @default("DE")
  status                CompanyStatus @default(IN_REVIEW)

  // Identity & Overview
  industryId            String?
  industry              Industry?     @relation(fields: [industryId], references: [id], onDelete: SetNull)
  subIndustryId         String?
  companySize           String?       // '1-10', '11-50', '51-200', '201-500', '501-1000', '1000+'
  foundedYear           Int?
  description           String?
  hiringDomestic        Boolean       @default(true)
  hiringInternational   Boolean       @default(false)
  hiringEu              Boolean       @default(false)

  // Contact Details
  email                 String?
  hrEmail               String?
  supportEmail          String?
  phone                 String?
  alternatePhone        String?
  website               String?

  // Address
  addressLine1          String?
  addressLine2          String?
  city                  String?
  state                 String?
  postalCode            String?

  // Branding Assets (Cloudinary)
  logoUrl               String?
  logoPublicId          String?
  bannerUrl             String?
  bannerPublicId        String?
  promoVideoUrl         String?
  promoVideoPublicId    String?

  // Verification & Review Metadata
  reviewedAt            DateTime?
  reviewedBy            String?
  reviewNotes           String?
  rejectionReason       String?
  suspensionReason      String?

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?

  subscriptions         Subscription[]
  invoices              Invoice[]
  candidateAccessLogs   CandidateAccessLog[]
  documents             CompanyDocument[]
  users                 CompanyUser[]
  invitations           CompanyInvitation[]
  auditLogs             CompanyAuditLog[]
  jobs                  Job[]
  candidates            Candidate[]
  teams                 Team[]
  roles                 Role[]

  @@index([name])
  @@index([status])
  @@index([industryId])
  @@index([email])
  @@map("companies")
}

model Plan {
  id                   String              @id @default(uuid())
  name                 String
  description          String?
  price                Decimal             @db.Decimal(10, 2)
  offerPrice           Decimal?            @db.Decimal(10, 2)
  currency             String              @default("EUR")
  billingInterval      PlanBillingInterval
  candidateAccessLimit Int                 @default(0)
  jobPostingLimit      Int                 @default(0)
  teamMemberLimit      Int                 @default(0)
  status               PlanStatus          @default(ACTIVE)
  stripePriceId        String?
  stripeProductId      String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?

  subscriptions Subscription[]

  @@index([status])
  @@index([billingInterval])
  @@map("plans")
}

model Subscription {
  id                      String              @id @default(uuid())
  companyId               String
  company                 Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  planId                  String
  plan                    Plan                @relation(fields: [planId], references: [id], onDelete: Restrict)
  status                  SubscriptionStatus  @default(ACTIVE)
  startDate               DateTime
  endDate                 DateTime?
  nextBillingDate         DateTime?
  billingInterval         PlanBillingInterval
  currency                String              @default("EUR")
  price                   Decimal             @db.Decimal(10, 2)
  candidateAccessLimit    Int                 @default(0)
  jobPostingLimit         Int                 @default(0)
  teamMemberLimit         Int                 @default(0)
  candidateAccessUsage    Int                 @default(0)
  cancelledAt             DateTime?
  cancellationReason      String?
  revokedAt               DateTime?
  revokedReason           String?
  stripeCustomerId        String?
  stripeSubscriptionId    String?
  stripeCheckoutSessionId String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  invoices            Invoice[]
  candidateAccessLogs CandidateAccessLog[]

  @@index([companyId, status])
  @@index([status, endDate])
  @@index([stripeSubscriptionId])
  @@map("subscriptions")
}

model Invoice {
  id                     String        @id @default(uuid())
  invoiceNumber          String        @unique
  companyId              String
  company                Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  subscriptionId         String?
  subscription           Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  issueDate              DateTime      @default(now())
  dueDate                DateTime
  paidDate               DateTime?
  currency               String        @default("EUR")
  netAmount              Decimal       @db.Decimal(10, 2)
  taxRate                Decimal       @db.Decimal(5, 4)
  taxAmount              Decimal       @db.Decimal(10, 2)
  grossTotal             Decimal       @db.Decimal(10, 2)
  status                 InvoiceStatus @default(OPEN)
  legalNameSnapshot      String?
  taxIdSnapshot          String?
  billingAddressSnapshot String?
  stripeInvoiceId        String?
  stripePaymentIntentId  String?
  voidReason             String?
  voidedAt               DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  payments Payment[]

  @@index([companyId, status])
  @@index([invoiceNumber])
  @@index([status, dueDate])
  @@index([stripeInvoiceId])
  @@map("invoices")
}

model Payment {
  id                    String        @id @default(uuid())
  invoiceId             String
  invoice               Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("EUR")
  status                PaymentStatus @default(PENDING)
  paymentMethod         String        @default("stripe")
  stripePaymentIntentId String?
  stripeChargeId        String?
  errorMessage          String?
  refundedAmount        Decimal?      @db.Decimal(10, 2)
  paidAt                DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([invoiceId])
  @@index([stripePaymentIntentId])
  @@index([status])
  @@map("payments")
}

model StripeWebhookEvent {
  id          String   @id
  type        String
  status      String   @default("PROCESSED")
  processedAt DateTime @default(now())

  @@map("stripe_webhook_events")
}

model BillingAuditLog {
  id         String   @id @default(uuid())
  adminId    String?
  admin      Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  entityType String
  entityId   String
  action     String
  actor      String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([adminId, createdAt])
  @@map("billing_audit_logs")
}

model CandidateAccessLog {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  amount         Int          @default(1)
  reason         String?
  createdAt      DateTime     @default(now())

  @@index([subscriptionId, createdAt])
  @@index([companyId, createdAt])
  @@map("candidate_access_logs")
}

// ----------------------------------------------------
// Phase 1: Platform Configuration Enums and Models
// ----------------------------------------------------

enum ConfigurationStatus {
  ACTIVE
  INACTIVE
}

enum DocumentTargetType {
  COMPANY
  CANDIDATE
}

enum StageCategory {
  SOURCING
  SCREENING
  INTERVIEW
  EVALUATION
  OFFER
  HIRED
  REJECTED
  OTHER
}

model Industry {
  id          String              @id @default(uuid())
  name        String
  code        String?
  description String?
  parentId    String?
  parent      Industry?           @relation("IndustryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Industry[]          @relation("IndustryHierarchy")
  companies   Company[]
  jobs        Job[]
  status      ConfigurationStatus @default(ACTIVE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?
  deletedBy   String?

  @@unique([name, parentId])
  @@index([parentId])
  @@index([status])
  @@index([name])
  @@map("industries")
}

model DocumentDefinition {
  id                String              @id @default(uuid())
  targetType        DocumentTargetType
  name              String
  code              String?
  description       String?
  isRequired        Boolean             @default(false)
  acceptedFileTypes String[]
  maxFileSizeMb     Int                 @default(10)
  status            ConfigurationStatus @default(ACTIVE)
  companyDocuments  CompanyDocument[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  deletedBy         String?

  @@unique([targetType, name])
  @@index([targetType, status])
  @@map("document_definitions")
}

model RecruitmentStage {
  id          String              @id @default(uuid())
  name        String              @unique
  description String?
  category    StageCategory       @default(SCREENING)
  order       Int                 @default(0)
  status      ConfigurationStatus @default(ACTIVE)
  isSystem    Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  deletedAt   DateTime?
  deletedBy   String?

  jobApplications JobApplication[]
  previousStageHistories    ApplicationStageHistory[] @relation("StageHistoryPreviousStage")
  destinationStageHistories ApplicationStageHistory[] @relation("StageHistoryDestinationStage")

  @@index([order])
  @@index([status])
  @@map("recruitment_stages")
}

model PlatformSetting {
  id                           String   @id @default("global")
  acceptedResumeFileTypes      String[] @default(["application/pdf", ".pdf", "application/msword", ".doc", "application/vnd.openxmlformats-officedocument.wordprocessingml.document", ".docx"])
  autoApproveCandidateProfiles Boolean  @default(false)
  showEmployerContactDetails   Boolean  @default(false)
  showCandidateResumes         Boolean  @default(true)
  showCandidateFullName        Boolean  @default(true)
  showCandidateEmail           Boolean  @default(false)
  showCandidatePhone           Boolean  @default(false)
  autoApproveJobs              Boolean  @default(false)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  updatedBy                    String?

  @@map("platform_settings")
}

model PlatformConfigAuditLog {
  id         String   @id @default(uuid())
  adminId    String?
  admin      Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  entityType String
  entityId   String
  action     String
  actor      String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([adminId, createdAt])
  @@map("platform_config_audit_logs")
}

// ----------------------------------------------------
// Phase 2: Employer/Company Management Models
// ----------------------------------------------------

enum DocumentReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model CompanyDocument {
  id                    String                @id @default(uuid())
  companyId             String
  company               Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documentDefinitionId  String?
  documentDefinition    DocumentDefinition?   @relation(fields: [documentDefinitionId], references: [id], onDelete: SetNull)
  name                  String
  fileUrl               String
  publicId              String?
  fileSizeBytes         Int?
  mimeType              String?
  isPrivate             Boolean               @default(true)
  reviewStatus          DocumentReviewStatus  @default(PENDING)
  reviewedAt            DateTime?
  reviewedBy            String?
  rejectionReason       String?
  uploadedAt            DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([companyId])
  @@index([documentDefinitionId])
  @@index([reviewStatus])
  @@map("company_documents")
}

enum CompanyUserRole {
  OWNER
  ADMIN
  RECRUITER
  MEMBER
}

enum CompanyUserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

model CompanyUser {
  id                    String            @id @default(uuid())
  companyId             String
  company               Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email                 String
  firstName             String?
  lastName              String?
  role                  CompanyUserRole   @default(ADMIN)
  status                CompanyUserStatus @default(INVITED)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  invitations           CompanyInvitation[]
  customRoleId          String?
  customRole            Role?               @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  teamMembers           TeamMember[]

  @@unique([companyId, email])
  @@index([companyId])
  @@index([email])
  @@index([customRoleId])
  @@map("company_users")
}

model CompanyInvitation {
  id          String          @id @default(uuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId      String?
  user        CompanyUser?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email       String
  role        CompanyUserRole @default(ADMIN)
  customRoleId String?
  customRole  Role?           @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  tokenHash   String          @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  sentAt      DateTime        @default(now())
  createdAt   DateTime        @default(now())

  @@index([companyId])
  @@index([email])
  @@index([tokenHash])
  @@index([customRoleId])
  @@map("company_invitations")
}

model CompanyAuditLog {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  adminId    String?
  admin      Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     String
  actor      String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([adminId, createdAt])
  @@map("company_audit_logs")
}

// ----------------------------------------------------
// Phase 4: Job Postings, Candidates, and Applications
// ----------------------------------------------------

enum JobWorkArrangement {
  REMOTE
  HYBRID
  ON_SITE
}

enum JobEmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum JobHiringScope {
  DOMESTIC
  EU
  INTERNATIONAL
}

enum JobStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum CandidateStatus {
  PENDING_APPROVAL
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ApplicationStatus {
  SUBMITTED
  IN_REVIEW
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

model Job {
  id                 String             @id @default(uuid())
  companyId          String
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title              String
  slug               String?
  jobCode            String?
  industryId         String?
  industry           Industry?          @relation(fields: [industryId], references: [id], onDelete: SetNull)
  keywords           String[]           @default([])
  department         String?
  profession         String?
  openings           Int                @default(1)
  hiringManagerId    String?
  recruiterId        String?
  targetJoiningDate  DateTime?
  compensationType   String             @default("ANNUAL")
  salaryNegotiable   Boolean            @default(false)
  minExperience      Int                @default(0)
  maxExperience      Int                @default(5)
  maxApplicantsLimit Int?
  autoCloseOnLimit   Boolean            @default(false)
  address            String?
  city               String?
  state              String?
  country            String             @default("DE")
  location           String?
  workArrangement    JobWorkArrangement   @default(ON_SITE)
  workArrangements   JobWorkArrangement[] @default([ON_SITE])
  employmentType     JobEmploymentType    @default(FULL_TIME)
  hiringScope        JobHiringScope     @default(DOMESTIC)
  hiringScopes       JobHiringScope[]   @default([DOMESTIC])
  currency           String             @default("EUR")
  minSalary          Decimal?           @db.Decimal(10, 2)
  maxSalary          Decimal?           @db.Decimal(10, 2)
  germanLevel        String?
  englishLevel       String?
  otherLanguages     Json?
  description        String
  responsibilities   String?
  requirements       String?
  benefits           String?
  status             JobStatus          @default(DRAFT)
  publishedAt        DateTime?
  expiresAt          DateTime?
  createdById        String?
  approvedAt         DateTime?
  approvedBy         String?
  rejectionReason    String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  applications       JobApplication[]
  savedBy            SavedJob[]

  @@index([companyId])
  @@index([status])
  @@index([hiringScope])
  @@index([country])
  @@index([city])
  @@index([publishedAt])
  @@index([expiresAt])
  @@index([jobCode])
  @@index([industryId])
  @@map("jobs")
}

model Candidate {
  id                String          @id @default(uuid())
  email             String          @unique
  firstName         String
  middleName        String?
  lastName          String
  fullName          String?
  phone             String?
  alternateMobile   String?
  dateOfBirth       DateTime?
  gender            String?
  maritalStatus     String?
  nationality       String?

  // Address Details
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  postalCode        String?
  country           String          @default("DE")

  // Professional Background
  profession        String?
  employmentType    String?
  currentJobTitle   String?
  currentCompany    String?
  yearsOfExperience Decimal?        @db.Decimal(4, 1)
  noticePeriodDays  Int?
  currentSalary     Decimal?        @db.Decimal(12, 2)
  expectedSalary    Decimal?        @db.Decimal(12, 2)
  preferredLocation String?
  willingToRelocate Boolean         @default(false)
  headline          String?
  summary           String?
  currentLocation   String?
  source            String          @default("CAREER_PORTAL")

  // Work Authorization & Global Mobility
  passportNumber        String?
  passportExpiryDate    DateTime?
  visaStatus            String?
  workPermitAuthorized  Boolean         @default(false)

  // Online Profiles
  linkedinUrl       String?
  portfolioUrl      String?
  githubUrl         String?

  // Profile Completion Score (0-100)
  profileCompletion Int             @default(0)

  // Authentication & Security Credentials
  passwordHash             String?
  emailVerified            Boolean         @default(false)
  verificationTokenHash    String?
  passwordResetTokenHash   String?
  passwordResetExpiresAt   DateTime?
  lastLoginAt              DateTime?
  failedLoginAttempts      Int             @default(0)
  lockedUntil              DateTime?

  // Account Invitation & Activation
  invitationTokenHash      String?
  invitationExpiresAt      DateTime?
  invitationSentAt         DateTime?
  invitationStatus         String?         @default("NONE")

  // Company Association
  companyId                String?
  company                  Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)

  status            CandidateStatus @default(ACTIVE)
  resumeUrl         String?
  resumePublicId    String?
  resumeFileName    String?
  resumeMimeType    String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  applications      JobApplication[]
  savedJobs         SavedJob[]

  @@index([email])
  @@index([status])
  @@index([country])
  @@index([city])
  @@index([profession])
  @@index([deletedAt])
  @@index([companyId])
  @@index([invitationTokenHash])
  @@map("candidates")
}

model SavedJob {
  id          String    @id @default(uuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  savedAt     DateTime  @default(now())
  expiresAt   DateTime?

  @@unique([candidateId, jobId])
  @@index([candidateId])
  @@index([jobId])
  @@map("saved_jobs")
}

model JobApplication {
  id             String            @id @default(uuid())
  jobId          String
  job            Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId    String
  candidate      Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  currentStageId String?
  currentStage   RecruitmentStage? @relation(fields: [currentStageId], references: [id], onDelete: SetNull)
  status         ApplicationStatus @default(SUBMITTED)
  coverLetter    String?
  resumeUrl      String?
  appliedAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  stageHistories ApplicationStageHistory[]

  @@unique([jobId, candidateId])
  @@index([jobId])
  @@index([candidateId])
  @@index([currentStageId])
  @@index([status])
  @@map("job_applications")
}

model ApplicationStageHistory {
  id                 String            @id @default(uuid())
  applicationId      String
  application        JobApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  previousStageId    String?
  previousStage      RecruitmentStage? @relation("StageHistoryPreviousStage", fields: [previousStageId], references: [id], onDelete: SetNull)
  destinationStageId String
  destinationStage   RecruitmentStage  @relation("StageHistoryDestinationStage", fields: [destinationStageId], references: [id], onDelete: Restrict)
  actorId            String?
  actor              Admin?            @relation(fields: [actorId], references: [id], onDelete: SetNull)
  notes              String?
  reviewerNotes      String?
  rejectionReason    String?
  createdAt          DateTime          @default(now())

  @@index([applicationId])
  @@index([destinationStageId])
  @@index([previousStageId])
  @@index([actorId])
  @@index([createdAt])
  @@map("application_stage_histories")
}

// ----------------------------------------------------
// Phase 5: Teams & Permission Management (RBAC)
// ----------------------------------------------------

model Team {
  id          String       @id @default(uuid())
  name        String
  description String?
  companyId   String?
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  members     TeamMember[]

  @@index([companyId])
  @@index([name])
  @@map("teams")
}

model Role {
  id          String           @id @default(uuid())
  name        String
  code        String
  description String?
  isSystem    Boolean          @default(false)
  companyId   String?
  company     Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  permissions  RolePermission[]
  teamMembers  TeamMember[]
  companyUsers CompanyUser[]
  invitations  CompanyInvitation[]

  @@index([companyId])
  @@index([code])
  @@map("roles")
}

model RolePermission {
  id        String   @id @default(uuid())
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module    String   // DASHBOARD, COMPANIES, CANDIDATES, JOBS, APPLICATIONS, TEAMS, BILLING
  action    String   // READ, CREATE, EDIT, DELETE, EXPORT
  allowed   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roleId, module, action])
  @@index([roleId])
  @@index([module])
  @@map("role_permissions")
}

model TeamMember {
  id            String       @id @default(uuid())
  teamId        String
  team          Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  adminId       String?
  admin         Admin?       @relation(fields: [adminId], references: [id], onDelete: Cascade)
  companyUserId String?
  companyUser   CompanyUser? @relation(fields: [companyUserId], references: [id], onDelete: Cascade)
  roleId        String?
  role          Role?        @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([teamId, adminId])
  @@unique([teamId, companyUserId])
  @@index([teamId])
  @@index([adminId])
  @@index([companyUserId])
  @@index([roleId])
  @@map("team_members")
}

enum DevicePlatform {
  WEB
  IOS
  ANDROID
}

model AdminDeviceToken {
  id        String         @id @default(uuid())
  adminId   String
  admin     Admin          @relation(fields: [adminId], references: [id], onDelete: Cascade)
  token     String         @unique
  platform  DevicePlatform @default(WEB)
  userAgent String?
  createdAt DateTime       @default(now())
  lastUsedAt DateTime      @default(now())
  updatedAt DateTime       @updatedAt

  @@index([adminId])
  @@index([platform])
  @@map("admin_device_tokens")
}

model AdminNotification {
  id          String    @id @default(uuid())
  adminId     String
  admin       Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  title       String
  body        String
  category    String    @default("GENERAL")
  deepLinkUrl String?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([adminId])
  @@index([adminId, isRead])
  @@index([adminId, createdAt])
  @@index([isRead])
  @@index([createdAt])
  @@map("admin_notifications")
}

