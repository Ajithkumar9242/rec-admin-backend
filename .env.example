NODE_ENV=development
PORT=5000

# PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recruitrain_admin?schema=public

# Redis Connection URL
REDIS_URL=redis://localhost:6379

# Server-Side Session Secret (at least 32 random characters in production)
SESSION_SECRET=recruitrain_super_secure_session_secret_replace_in_production_32chars

# Cookie Settings
COOKIE_NAME=recruitrain_admin_sid
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Allowed CORS Origins (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Public URL
FRONTEND_URL=http://localhost:5173

# Initial Super Admin Bootstrap Credentials
SUPER_ADMIN_EMAIL=superadmin@recruitrain.com
SUPER_ADMIN_PASSWORD=RecruiTrain@2026!Secure
SUPER_ADMIN_NAME=Platform Super Administrator

# Security Policies
LOGIN_MAX_FAILED_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
PASSWORD_RESET_EXPIRES_MINUTES=60

# SMTP Email Configuration (Leave empty in local dev to print reset links to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RecruiTrain Security" <security@recruitrain.com>
SMTP_SECURE=false
