NODE_ENV=development
PORT=5000

# PostgreSQL Connection String (Development/Production)
# NOTE: Test suites strictly use a dedicated test database (e.g. recruitrain_admin_test) configured via .env.test.
# Tests will refuse to run against recruitrain_admin.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recruitrain_admin?schema=public

# Redis Connection URL
REDIS_URL=redis://127.0.0.1:6379

# Server-Side Session Secret (at least 32 random characters in production)
SESSION_SECRET=recruitrain_super_secure_session_secret_replace_in_production_32chars

# Dedicated 32-byte Hex Key for Authenticated MFA Secret Encryption (AES-256-GCM)
MFA_ENCRYPTION_KEY=e15f27b0e2a966028848a85aa925ea70d33d7c6492e62e3fb433bf1c25e5b599

# Cookie Settings
COOKIE_NAME=recruitrain_admin_sid
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Allowed CORS Origins (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Public URL
FRONTEND_URL=http://localhost:5173

# Initial Super Admin Bootstrap Credentials
SUPER_ADMIN_EMAIL=superadmin@recruitrain.com
SUPER_ADMIN_PASSWORD=RecruiTrain@2026!Secure
SUPER_ADMIN_NAME=Platform Super Administrator

# Security Policies
LOGIN_MAX_FAILED_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
PASSWORD_RESET_EXPIRES_MINUTES=60

# SMTP Email Configuration (Leave empty in local dev to fail safely and report missing SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RecruiTrain Security" <security@recruitrain.com>
SMTP_SECURE=false
