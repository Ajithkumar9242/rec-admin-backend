NODE_ENV=development
PORT=5000

# PostgreSQL Connection String (Development/Production)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recruitrain_admin?schema=public

# Dedicated PostgreSQL Test Database Connection String (Used strictly during test execution)
# Hard safety guard strictly rejects running tests against recruitrain_admin.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recruitrain_admin_test?schema=public

# Redis Connection URL
REDIS_URL=redis://127.0.0.1:6379

# Server-Side Session Secret (at least 32 random characters in production)
SESSION_SECRET=replace_with_a_secure_session_secret_at_least_32_chars

# Dedicated 32-byte Hex Key for Authenticated MFA Secret Encryption (AES-256-GCM) (64 hex characters)
MFA_ENCRYPTION_KEY=replace_with_64_character_hex_encryption_key_32_bytes_long_here_0123

# Cookie Settings
COOKIE_NAME=recruitrain_admin_sid
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Allowed CORS Origins (comma separated)
# Must include both Admin Frontend (e.g. http://localhost:5173) and Employer Portal (e.g. http://localhost:5174)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Frontend Public URL
FRONTEND_URL=http://localhost:5173

# Initial Super Admin Bootstrap Credentials
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=ReplaceWithStrongPassword123!
SUPER_ADMIN_NAME=Platform Super Administrator

# Security Policies
LOGIN_MAX_FAILED_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
PASSWORD_RESET_EXPIRES_MINUTES=60

# Stripe Payment Configuration (Sandbox / Test Mode)
# In production/test, missing credentials safely marks payment integration as unconfigured.
STRIPE_SECRET_KEY=sk_test_placeholder_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret

# SMTP Email Configuration (Leave empty in local dev to fail safely and report missing SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RecruiTrain Security" <security@recruitrain.com>
SMTP_SECURE=false

# Cloudinary Storage Configuration (Private document & branding uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=recruitrain

# Employer Application & Invitation Activation URLs
# In production, EMPLOYER_APP_URL must be a public HTTPS URL and cannot point to localhost/loopback.
EMPLOYER_APP_URL=http://localhost:5174
EMPLOYER_ACTIVATION_PATH=/activate
COMPANY_INVITATION_EXPIRES_HOURS=48

# Candidate Application & Invitation Activation URLs
# In production, CANDIDATE_APP_URL must be a public HTTPS URL and cannot point to localhost/loopback.
CANDIDATE_APP_URL=http://localhost:5173
CANDIDATE_ACTIVATION_PATH=/activate
CANDIDATE_INVITATION_EXPIRES_HOURS=48

# Firebase Cloud Messaging (FCM) & Push Notifications (Optional)
# If unconfigured or credentials absent, push delivery safely skips delivery without error.
FIREBASE_PROJECT_ID=placeholder-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-placeholder@placeholder-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC3placeholder\n-----END PRIVATE KEY-----\n"


