NODE_ENV=test
PORT=5001

# Dedicated PostgreSQL Test Database Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recruitrain_admin_test?schema=public

# Redis Connection URL
REDIS_URL=redis://127.0.0.1:6379

# Server-Side Session Secret for Testing
SESSION_SECRET=recruitrain_test_session_secret_min32chars_test_suite_key

# 32-byte Hex Key for Authenticated MFA Secret Encryption (AES-256-GCM)
MFA_ENCRYPTION_KEY=e15f27b0e2a966028848a85aa925ea70d33d7c6492e62e3fb433bf1c25e5b599

# Cookie Settings
COOKIE_NAME=recruitrain_admin_sid_test
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Allowed CORS Origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Public URL
FRONTEND_URL=http://localhost:5173

# Security Policies
LOGIN_MAX_FAILED_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
PASSWORD_RESET_EXPIRES_MINUTES=60

# SMTP Settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RecruiTrain Security Test" <security@recruitrain.test>
SMTP_SECURE=false
