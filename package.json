    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "helmet": "^7.2.0",
    "ioredis": "^5.4.1",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "nodemailer": "^6.9.16",
    "otplib": "^12.0.1",
